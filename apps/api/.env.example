# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=nest_base

# App
PORT=3000

# JWT
JWT_SECRET=your-secret-key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Encryption (64-character hex string, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-aes-256-key-64-hex-chars-here-0123456789abcdef01234567

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=mxbai-embed-large

# Vector Store (Chroma)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=knowledge_base
