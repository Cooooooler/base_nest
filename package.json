{
  "name": "base_nest",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "node clean.js",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "lint": "turbo run lint",
    "migration:generate": "pnpm --filter @base/api run migration:generate",
    "migration:revert": "pnpm --filter @base/api run migration:revert",
    "migration:run": "pnpm --filter @base/api run migration:run",
    "prepare": "husky",
    "start:dev": "pnpm --filter @base/api run start:dev",
    "start:prod": "pnpm --filter @base/api run start:prod",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @base/api run test:e2e",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "catalog:",
    "lint-staged": "^17.0.7",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@10.33.2"
}
